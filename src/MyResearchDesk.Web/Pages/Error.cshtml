@page "{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    var notFound = Model.Code == 404;
}

<h1 class="h3">@(notFound ? "Page not found" : "Something went wrong")</h1>
<p class="text-muted">
    @(notFound ? "That page or article doesn't exist (it may have been deleted)." : "An unexpected error occurred. Please try again.")
</p>
<a class="btn btn-primary" asp-page="/Index">Back to dashboard</a>

@if (Model.ShowRequestId)
{
    <p class="small text-muted mt-3">Request ID: <code>@Model.RequestId</code></p>
}
