@page
@model MyResearchDesk.Web.Pages.Articles.CreateModel
@{
    ViewData["Title"] = "Add article";
}

<h1 class="h3 mb-3">Add article</h1>
<form method="post">
    <partial name="_Form" for="Input" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
