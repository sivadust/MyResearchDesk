@page "{id:guid}"
@model MyResearchDesk.Web.Pages.Articles.DeleteModel
@{
    ViewData["Title"] = "Delete article";
}

<h1 class="h3 mb-3">Delete article</h1>
<div class="alert alert-warning">
    Permanently delete <strong>@Model.Article.Title</strong>? This cannot be undone.
</div>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>
